{
  "name": "catan-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "build": "node scripts/build-site.mjs global",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:home": "node scripts/home-showcase-browser.js",
    "test:terrain": "node scripts/terrain-layout-browser.js",
    "test:viewport": "node scripts/viewport-stage-browser.js",
    "test:immersive": "node scripts/immersive-ui-browser.js",
    "test:polish": "node scripts/immersive-polish-browser.js",
    "test:map:polish": "node scripts/map-polish-browser.js",
    "test:practice:protocol": "node scripts/practice-protocol-smoke.js",
    "test:worker": "node scripts/worker-smoke.js",
    "test:multiplayer": "node scripts/multiplayer-browser.js",
    "worker:dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8788",
    "worker:check": "wrangler deploy --dry-run --outdir .local/worker",
    "deploy": "npm run build && wrangler deploy",
    "test:integration": "node scripts/integration-browser.js",
    "test:worker:restart": "node scripts/worker-restart-smoke.js",
    "test:secure-worker": "node scripts/secure-worker-smoke.js",
    "test:chat-report:browser": "node scripts/chat-report-browser.js",
    "test:node:restart": "node scripts/node-restart-smoke.js",
    "build:cn": "node scripts/build-site.mjs cn",
    "build:global": "node scripts/build-site.mjs global",
    "test:site": "node --test tests/site-policy.test.js tests/worker-lifecycle.test.js tests/integration-policy.test.js tests/deploy-release.test.js",
    "typecheck": "tsc --noEmit",
    "check": "node --check src/main.js && npm run typecheck",
    "test:migration": "node scripts/react-migration-browser.mjs",
    "test:visuals": "node --test tests/visual-assets.test.js",
    "test:visuals:browser": "node scripts/visual-assets-browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "4.157.0"
  }
}
