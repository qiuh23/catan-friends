{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catan-friends",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "CatanRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CatanRoom"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "STATE_SCHEMA": "3",
    "REPORT_CONTACT": "qiutian0808@163.com",
    "MODERATION_RETENTION_DAYS": "90",
    "BACKEND_ID": "cloudflare",
    "PUBLIC_ORIGIN": "https://catan-friends.qiuh23.workers.dev",
    "SITE_EDITION": "global"
  },
  "ratelimits": [
    {
      "name": "CATAN_RATE_LIMITER",
      "namespace_id": "3005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
