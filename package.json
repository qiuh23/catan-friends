{
  "name": "catan-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:worker": "node scripts/worker-smoke.js",
    "test:multiplayer": "node scripts/multiplayer-browser.js",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8788",
    "worker:check": "wrangler deploy --dry-run --outdir .local/worker",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "three": "^0.186.1", "ws": "^8.18.3" },
  "devDependencies": { "vite": "^7.1.0", "wrangler": "^4.151.3", "playwright": "^1.56.0" }
}
